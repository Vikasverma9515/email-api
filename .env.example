GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
API_SECRET=pick-any-long-random-string-here
FROM_NAME=Your Full Name

# Your deployed Vercel URL — used for open tracking pixels in emails
APP_URL=https://your-project-name.vercel.app

# Upstash Redis — for persistent tracking across deployments
# Create free DB at upstash.com → copy REST URL + token
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
